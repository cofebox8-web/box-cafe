{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/customer/:branch/:token", "destination": "/menu" },
    { "source": "/customer/:branch", "destination": "/menu" },
    { "source": "/customer", "destination": "/menu" },
    { "source": "/menu/:branch/:token", "destination": "/menu" },
    { "source": "/menu/:branch", "destination": "/menu" },
    { "source": "/kitchen/:branch", "destination": "/kitchen" },
    { "source": "/roadside/order", "destination": "/roadside" },
    { "source": "/admin/:section", "destination": "/admin" },
    {
      "source": "/login",
      "destination": "/login"
    }
  ]
}
