{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/menu/:path*",
      "destination": "/menu.html"
    },
    {
      "source": "/kitchen/:path*",
      "destination": "/kitchen.html"
    },
    {
      "source": "/roadside/:path*",
      "destination": "/roadside.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    }
  ]
}
